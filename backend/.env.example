# PostgreSQL connection string from Neon (https://neon.tech)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

JWT_SECRET="replace_with_a_long_random_secret_at_least_32_chars"
PORT=4000

# SMTP — Gmail with App Password (requires 2FA enabled on your Google account)
# Go to: Google Account → Security → 2-Step Verification → App passwords → generate for "Mail"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.gmail@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
SMTP_FROM="Twin Lakes Lodge <no-reply@twinlakes.local>"

# Frontend base URL — used in invite email links AND allowed in CORS
APP_URL=http://localhost:5173

# In production: set both to your deployed frontend URL (e.g. https://twin-lakes.vercel.app)
# APP_URL=https://twin-lakes.vercel.app
# FRONTEND_URL=https://twin-lakes.vercel.app

# SMS — Africa's Talking (leave blank to run in stub mode)
AT_USERNAME=
AT_API_KEY=
AT_SENDER=
